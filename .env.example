# Application
NODE_ENV=development
PORT=3000
APP_NAME=School Management API

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=8h

# Database MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=school_management
DB_USERNAME=admin
DB_PASSWORD=12345678

# Prisma
DATABASE_URL="mysql://admin:12345678@127.0.0.1:3306/school_management"

# CORS - Comma-separated list of allowed origins (use * for all)
CORS_ORIGINS=http://localhost:3000,http://localhost:4000,http://localhost:8080,http://localhost:5173
